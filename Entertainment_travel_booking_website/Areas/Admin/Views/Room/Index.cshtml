@using Ecommerce.Utilities
@model IEnumerable<Entertainment_travel_booking_website.Models.Room>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Rooms Management";
}
@section Scripts {

    @if (TempData["sucess-Notification"] != null)
    {
        <script>
            toastr.success('@TempData["sucess-Notification"]');
        </script>
    }
    else if (TempData["error-Notification"] != null)
    {
        <script>
            toastr.error('@TempData["error-Notification"]');
        </script>
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Rooms Inventory</h2>
        <p class="text-muted mb-0">Manage hotel rooms, types, and real-time availability</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
        <i class="bi bi-plus-circle me-2"></i>Add New Room
    </a>
</div>

<div class="table-responsive">
    <table class="table align-middle table-hover bg-white" style="border-radius: 12px; overflow: hidden; border-collapse: separate; border-spacing: 0;">
        <thead class="bg-light">
            <tr>
                <th class="border-0 ps-4 py-3 text-uppercase fs-7 fw-bold text-muted">Room Details</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Type</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Location</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Status</th>
                <th class="border-0 py-3 text-end pe-4 text-uppercase fs-7 fw-bold text-muted">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var room in Model)
                {
                    <tr style="border-bottom: 1px solid #f0f0f0;">
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center">
                                <div class="symbol symbol-50px me-3 bg-light-primary d-flex align-items-center justify-content-center rounded" style="width: 45px; height: 45px;">
                                    <i class="bi bi-door-open fs-4 text-primary"></i>
                                </div>
                                <div>
                                    <span class="text-dark fw-bold d-block fs-6">Room #@room.ID</span>
                                    <small class="text-muted">@(room.Description?.Length > 30 ? room.Description.Substring(0, 30) + "..." : room.Description)</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light-info text-info px-3 py-2 border border-info rounded-pill">
                                <i class="bi bi-tag-fill me-1"></i> @room.Type
                            </span>
                        </td>
                        <td>
                            <span class="text-dark fw-medium">@room.locationInHotel</span>
                        </td>
                        <td>
                            @if (room.Availability)
                            {
                                <span class="badge bg-light-success text-success px-3 py-2 border border-success rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Ready to Book
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light-danger text-danger px-3 py-2 border border-danger rounded-pill">
                                    <i class="bi bi-dash-circle-fill me-1"></i> Maintenance
                                </span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm btn-icon shadow-none" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                @if (User.IsInRole(DS.SUPER_ADMIN_ROLE) || User.IsInRole(DS.ADMIN_ROLE))
                                {
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm p-2">
                                        <li>
                                            <a class="dropdown-item rounded" asp-action="Edit" asp-route-id="@room.ID">
                                                <i class="bi bi-pencil-square me-2 text-primary"></i> Edit Room
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider text-light"></li>
                                        <li>
                                            <a class="dropdown-item rounded text-danger" asp-action="Delete" asp-route-id="@room.ID"
                                            onclick="return confirm('Are you sure you want to delete this room?');">
                                                <i class="bi bi-trash3 me-2"></i> Delete
                                            </a>
                                        </li>
                                    </ul>
                                }
                                else
                                {
                                     <td>NO Action!</td>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-5">
                        <div class="d-flex flex-column align-items-center">
                            <i class="bi bi-inbox text-muted display-4 mb-3"></i>
                            <h5 class="text-muted">No rooms registered yet</h5>
                            <a asp-action="Create" class="btn btn-sm btn-outline-primary mt-2">Add your first room</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


    <style>
        /* ستايلات خاصة لزيادة الاحترافية */
        .fs-7 {
            font-size: 0.85rem;
        }

        .bg-light-primary {
            background-color: #eef6ff !important;
        }

        .bg-light-info {
            background-color: #f0faff !important;
        }

        .bg-light-success {
            background-color: #e8fff3 !important;
        }

        .bg-light-danger {
            background-color: #fff5f8 !important;
        }

        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
        }

        .table tbody tr:last-child {
            border-bottom: none;
        }

        .table tbody tr:hover {
            background-color: #fcfcfc;
        }

        .dropdown-item {
            padding: 8px 12px;
            font-weight: 500;
            font-size: 0.9rem;
            transition: 0.2s;
        }

            .dropdown-item:hover {
                background-color: #f8f9fa;
            }
    </style>
