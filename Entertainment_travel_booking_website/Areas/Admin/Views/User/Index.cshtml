@model IEnumerable<ApplicationUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
}

@section Scripts {
    <script>
        function LockUnlock(userId) {
            if (confirm("Are you sure you want to change this user's status?")) {
                fetch('/Admin/User/LockUnlock', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        // تأكد من إضافة الـ Antiforgery Token إذا كان مفعلاً
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify(userId)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                });
            }
        }
    </script>

    @if (TempData["sucess-Notification"] != null)
    {
        <script>
            toastr.success('@TempData["sucess-Notification"]');
        </script>
    }
    else if (TempData["error-Notification"] != null)
    {
        <script>
            toastr.error('@TempData["error-Notification"]');
        </script>
    }
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">User Management</h2>
        <p class="text-muted mb-0">Monitor user activities and manage access permissions</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table align-middle table-hover bg-white" style="border-radius: 12px; overflow: hidden; border-collapse: separate; border-spacing: 0;">
        <thead class="bg-light">
            <tr>
                <th class="border-0 ps-4 py-3 text-uppercase fs-7 fw-bold text-muted">User Info</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Email</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Status</th>
                <th class="border-0 py-3 text-end pe-4 text-uppercase fs-7 fw-bold text-muted">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var user in Model)
                {
                    <tr style="border-bottom: 1px solid #f0f0f0;">
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center">
                                <div class="symbol symbol-50px me-3 bg-light-primary d-flex align-items-center justify-content-center rounded" style="width: 45px; height: 45px;">
                                    <i class="bi bi-person-fill fs-4 text-primary"></i>
                                </div>
                                <div>
                                    <span class="text-dark fw-bold d-block fs-6">@user.UserName</span>
                                    <small class="text-muted">ID: @user.Id.Substring(0, 8)...</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="text-dark fw-medium">@user.Email</span>
                        </td>
                        <td>
                            @if (user.LockoutEnd != null && user.LockoutEnd > DateTime.Now)
                            {
                                <span class="badge bg-light-danger text-danger px-3 py-2 border border-danger rounded-pill">
                                    <i class="bi bi-x-circle-fill me-1"></i> Blocked
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light-success text-success px-3 py-2 border border-success rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Active
                                </span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            @if (user.LockoutEnd != null && user.LockoutEnd > DateTime.Now)
                            {
                                <button onclick="LockUnlock('@user.Id')" class="btn btn-outline-success btn-sm px-3 rounded-pill">
                                    <i class="bi bi-unlock-fill me-1"></i> Unblock
                                </button>
                            }
                            else
                            {
                                <button onclick="LockUnlock('@user.Id')" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                                    <i class="bi bi-slash-circle me-1"></i> Block User
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


<style>
    /* نفس الستايلات التي استخدمتها في صفحة الغرف */
    .fs-7 {
        font-size: 0.85rem;
    }

    .bg-light-primary {
        background-color: #eef6ff !important;
    }

    .bg-light-success {
        background-color: #e8fff3 !important;
    }

    .bg-light-danger {
        background-color: #fff5f8 !important;
    }

    .table tbody tr:hover {
        background-color: #fcfcfc;
    }
</style>