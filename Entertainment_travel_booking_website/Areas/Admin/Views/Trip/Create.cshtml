@using Entertainment_travel_booking_website.modelVM
@model TripCreateVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Trip";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-plus-circle text-primary me-2"></i>Create New Trip</h2>
            <p class="text-muted mb-0">Fill in the details to launch a new travel package.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-info-circle me-2"></i>Destination & Pricing</h5>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Place" class="form-label fw-bold">Trip Destination</label>
                            <input asp-for="Place" class="form-control" placeholder="e.g. Maldives Summer Escape" />
                            <span asp-validation-for="Place" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold">Original Price ($)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DiscountedPrice" class="form-label fw-bold text-success">Discounted Price ($)</label>
                            <input asp-for="DiscountedPrice" class="form-control border-success" type="number" step="0.01" placeholder="Optional" />
                            <span asp-validation-for="DiscountedPrice" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-calendar-event me-2"></i>Logistics & Schedule</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-bold">Start Date</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-bold">End Date</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AvailableSeats" class="form-label fw-bold">Initial Available Seats</label>
                            <input asp-for="AvailableSeats" class="form-control" type="number" />
                            <span asp-validation-for="AvailableSeats" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaxPeople" class="form-label fw-bold">Max Capacity</label>
                            <input asp-for="MaxPeople" class="form-control" type="number" />
                            <span asp-validation-for="MaxPeople" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-card-text me-2"></i>Full Description</h5>
                    <textarea asp-for="Description" rows="5" class="form-control" placeholder="Describe the itinerary, activities, and inclusions..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3">Settings</h5>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold small">Publishing Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="true">Active / Visible</option>
                            <option value="false">Inactive / Hidden</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="HotelId" class="form-label fw-bold small text-primary">Associated Hotel</label>
                        <select asp-for="HotelId" class="form-select" asp-items="@(new SelectList(ViewBag.Hotels ?? new List<dynamic>(), "Id", "Name"))">
                            <option value="">-- Select Hotel --</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="AdditionalActivityId" class="form-label fw-bold small text-primary">Main Activity</label>
                        <select asp-for="AdditionalActivityId" class="form-select" asp-items="@(new SelectList(ViewBag.Activities ?? new List<dynamic>(), "Id", "Place"))">
                            <option value="">-- Select Activity --</option>
                        </select>
                    </div>
                </div>

                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3">Media Gallery</h5>
                    <div class="mb-3">
                        <label asp-for="MainImage" class="form-label fw-bold small">Main Cover Image</label>
                        <input asp-for="MainImage" type="file" class="form-control form-control-sm" accept="image/*" />
                        <span asp-validation-for="MainImage" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="SupImages" class="form-label fw-bold small">Additional Gallery</label>
                        <input asp-for="SupImages" type="file" multiple class="form-control form-control-sm" accept="image/*" />
                        <span asp-validation-for="SupImages" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 py-3 mt-4 fw-bold shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i> Create Trip Now
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .form-control, .form-select {
            border: 1px solid #ced4da;
            padding: 0.6rem 0.75rem;
            border-radius: 8px;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
            }

        .card {
            border-radius: 12px;
        }

        .form-label {
            margin-bottom: 0.4rem;
        }
    </style>
}