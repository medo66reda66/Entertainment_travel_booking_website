@using Entertainment_travel_booking_website.modelVM
@model TripVM

@{
    ViewData["Title"] = "Create Trip";
}

<h2 class="mb-4">Create New Trip</h2>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      class="row g-3">

    <!-- Place -->
    <div class="col-md-6">
        <label asp-for="Place" class="form-label"></label>
        <input asp-for="Place" class="form-control" />
        <span asp-validation-for="Place" class="text-danger"></span>
    </div>

    <!-- Price -->
    <div class="col-md-6">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <!-- Discounted Price -->
    <div class="col-md-6">
        <label asp-for="DiscountedPrice" class="form-label"></label>
        <input asp-for="DiscountedPrice" class="form-control" />
    </div>

    <!-- Start Date -->
    <div class="col-md-6">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <!-- End Date -->
    <div class="col-md-6">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <!-- Available Seats -->
    <div class="col-md-6">
        <label asp-for="AvailableSeats" class="form-label"></label>
        <input asp-for="AvailableSeats" class="form-control" />
    </div>

    <!-- Max People -->
    <div class="col-md-6">
        <label asp-for="MaxPeople" class="form-label"></label>
        <input asp-for="MaxPeople" class="form-control" />
    </div>

    <!-- Status -->
    <div class="col-md-6">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
    </div>

    <!-- Description -->
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description"
                  rows="4"
                  class="form-control"></textarea>
    </div>

    <!-- Main Image -->
    <div class="col-md-6">
        <label asp-for="MainImage" class="form-label">Main Image</label>
        <input asp-for="MainImage" type="file" class="form-control" />
        <span asp-validation-for="MainImage" class="text-danger"></span>
    </div>

    <!-- Sub Images -->
    <div class="col-md-6">
        <label asp-for="SupImages" class="form-label">Sub Images</label>
        <input asp-for="SupImages"
               type="file"
               multiple
               class="form-control" />
    </div>

    <!-- Buttons -->
    <div class="col-12 mt-4">
        <button type="submit" class="btn btn-success">
            Create Trip
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            Back
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
