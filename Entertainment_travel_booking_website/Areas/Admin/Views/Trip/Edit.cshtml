@using Entertainment_travel_booking_website.modelVM
@model TripEditVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Trip";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Trip</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Trips</a></li>
                    <li class="breadcrumb-item active">@Model.Place</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Primary Details</h5>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Place" class="form-label fw-bold">Trip Destination</label>
                            <input asp-for="Place" class="form-control" placeholder="Enter destination name" />
                            <span asp-validation-for="Place" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold">Original Price</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DiscountedPrice" class="form-label fw-bold text-success">Discounted Price</label>
                            <input asp-for="DiscountedPrice" class="form-control border-success" type="number" step="0.01" />
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Scheduling & Logistics</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-bold">Start Date</label>
                            <input asp-for="StartDate" type="date" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-bold">End Date</label>
                            <input asp-for="EndDate" type="date" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HotelId" class="form-label fw-bold">Assigned Hotel</label>
                            <select asp-for="HotelId" class="form-select" asp-items="@(new SelectList(ViewBag.Hotels, "Id", "Name"))">
                                <option value="">-- No Hotel --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AdditionalActivityId" class="form-label fw-bold">Activity</label>
                            <select asp-for="AdditionalActivityId" class="form-select" asp-items="@(new SelectList(ViewBag.Activities, "Id", "Place"))">
                                <option value="">-- No Activity --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3">Trip Status</h5>
                    <select asp-for="Status" class="form-select form-select-lg mb-2">
                        <option value="true">Active / Visible</option>
                        <option value="false">Inactive / Hidden</option>
                    </select>
                    <small class="text-muted">Controls if travelers can see this trip.</small>
                </div>

                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3">Trip Images</h5>

                    <label class="form-label fw-bold small">Current Cover</label>
                    <div class="mb-3">
                        <img src="~/images/trips/@Model.ExistingMainImage" class="img-fluid rounded border mb-2" style="max-height: 150px; width: 100%; object-fit: cover;" />
                        <input asp-for="MainImage" type="file" class="form-control form-control-sm" />
                    </div>

                    <label class="form-label fw-bold small">Gallery Preview</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var img in Model.ExistingSupImages)
                        {
                            <img src="~/images/trip-sup/@img.SupImg" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                    </div>
                    <input asp-for="SupImages" type="file" multiple class="form-control form-control-sm" />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 mt-4 fw-bold shadow">
                    <i class="bi bi-save me-2"></i> Save All Changes
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .form-control, .form-select {
            border: 1px solid #ced4da;
            padding: 0.6rem 0.75rem;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
            }

        .card {
            border-radius: 12px;
        }
    </style>
}