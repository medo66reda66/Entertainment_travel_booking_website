@model Entertainment_travel_booking_website.modelVM.AdditionalActivityVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Activity";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Activity</h2>
            <p class="text-muted mb-0">Update the details and gallery for: <strong>@Model.Place</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Primary Information</h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Place" class="form-label fw-bold">Activity Name / Place</label>
                            <input asp-for="Place" class="form-control" />
                            <span asp-validation-for="Place" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold">Detailed Description</label>
                            <textarea asp-for="Description" rows="8" class="form-control">@Model.Description</textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Logistics</h5>
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Price ($)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input asp-for="Price" class="form-control shadow-none" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Date" class="form-label fw-bold">Event Date</label>
                        <input asp-for="Date" type="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Activity Gallery</h5>

                    @if (Model.ExistingSubImages != null && Model.ExistingSubImages.Any())
                    {
                        <label class="form-label fw-bold small text-muted">Current Gallery</label>
                        <div class="d-flex flex-wrap gap-2 mb-3 p-2 bg-light rounded border">
                            @foreach (var img in Model.ExistingSubImages)
                            {
                                <div class="position-relative">
                                    <img src="~/images/additionalActivities/@img" class="rounded border shadow-xs" style="width: 60px; height: 60px; object-fit: cover;" alt="Activity Image" />
                                </div>
                            }
                        </div>
                    }

                    <div class="mb-1">
                        <label asp-for="SubImageFiles" class="form-label fw-bold small">Add More Photos</label>
                        <input asp-for="SubImageFiles" type="file" multiple class="form-control form-control-sm" accept="image/*" />
                        <span asp-validation-for="SubImageFiles" class="text-danger small"></span>
                        <p class="form-text mt-2 mb-0" style="font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-1"></i> New photos will be added to the existing gallery.
                        </p>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm rounded-3">
                    <i class="bi bi-check2-circle me-2"></i> Save Changes
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <style>
        body {
            background-color: #f8f9fa;
        }

        .form-control, .form-select {
            border: 1px solid #ced4da;
            padding: 0.6rem 0.75rem;
            border-radius: 8px;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
            }

        .card {
            border-radius: 15px;
        }

        .input-group-text {
            border: 1px solid #ced4da;
            border-radius: 8px 0 0 8px;
        }
    </style>
}