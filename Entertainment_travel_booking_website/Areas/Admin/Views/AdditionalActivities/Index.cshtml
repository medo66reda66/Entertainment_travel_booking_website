@model IEnumerable<Entertainment_travel_booking_website.Models.AdditianActivities>

@{
    ViewData["Title"] = "Additional Activities";
}

<h2 class="mb-4">Additional Activities</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Activity</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Place</th>
            <th>Description</th>
            <th>Price</th>
            <th>Date</th>
            <th>Sub Images</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var activity in Model)
        {
            <tr>
                <td>@activity.Place</td>
                <td>@activity.Description</td>
                <td>@activity.Price.ToString("C")</td>
                <td>@activity.Date.ToShortDateString()</td>
                <td>
                    @if (activity.ActivitiesSupImgs != null && activity.ActivitiesSupImgs.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in activity.ActivitiesSupImgs)
                            {
                                <img src="~/images/additionalActivities/@img.SupImg"
                                     alt="Sub Image"
                                     width="80"
                                     height="80"
                                     class="img-thumbnail" />
                            }
                        </div>
                    }
                    else
                    {
                        <span>No images</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@activity.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@activity.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this activity?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
