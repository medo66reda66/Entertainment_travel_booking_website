@using Ecommerce.Utilities
@model IEnumerable<Entertainment_travel_booking_website.Models.AdditianActivities>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Additional Activities";
}
@section Scripts {

    @if (TempData["sucess-Notification"] != null)
    {
        <script>
            toastr.success('@TempData["sucess-Notification"]');
        </script>
    }
    else if (TempData["error-Notification"] != null)
    {
        <script>
            toastr.error('@TempData["error-Notification"]');
        </script>
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Extra Experiences</h2>
        <p class="text-muted mb-0">Manage excursions, tours, and entertainment events</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm fw-bold">
        <i class="bi bi-plus-circle me-2"></i>Add New Activity
    </a>
</div>

<div class="table-responsive">
    <table class="table align-middle table-hover bg-white shadow-sm" style="border-radius: 12px; overflow: hidden; border-collapse: separate; border-spacing: 0;">
        <thead class="bg-light">
            <tr>
                <th class="border-0 ps-4 py-3 text-muted small fw-bold text-uppercase">Activity Details</th>
                <th class="border-0 py-3 text-muted small fw-bold text-uppercase">Description</th>
                <th class="border-0 py-3 text-muted small fw-bold text-uppercase text-center">Date</th>
                <th class="border-0 py-3 text-muted small fw-bold text-uppercase">Price</th>
                <th class="border-0 py-3 text-muted small fw-bold text-uppercase">Gallery</th>
                <th class="border-0 py-3 text-end pe-4 text-muted small fw-bold text-uppercase">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var activity in Model)
                {
                    <tr style="border-bottom: 1px solid #f8f9fa;">
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-light-warning rounded-3 d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px;">
                                    <i class="bi bi-camera-reels text-warning fs-4"></i>
                                </div>
                                <div>
                                    <span class="fw-bold text-dark d-block">@activity.Place</span>
                                    <small class="text-muted">Event Activity</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <p class="mb-0 text-muted small text-truncate" style="max-width: 220px;" title="@activity.Description">
                                @activity.Description
                            </p>
                        </td>
                        <td class="text-center">
                            <div class="badge bg-light text-dark border fw-medium px-3 py-2 rounded-pill shadow-xs">
                                <i class="bi bi-calendar3 me-2 text-primary small"></i>@activity.Date.ToString("dd MMM, yyyy")
                            </div>
                        </td>
                        <td>
                            <span class="fw-bold text-primary">@activity.Price.ToString("C")</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center ms-2">
                                @if (activity.ActivitiesSupImgs != null && activity.ActivitiesSupImgs.Any())
                                {
                                    <div class="avatar-group d-flex align-items-center">
                                        @foreach (var img in activity.ActivitiesSupImgs.Take(3))
                                        {
                                            <img src="~/images/additionalActivities/@img.SupImg"
                                                 class="rounded-circle border border-white border-2 shadow-sm"
                                                 style="width: 30px; height: 30px; object-fit: cover; margin-left: -10px;" />
                                        }
                                        @if (activity.ActivitiesSupImgs.Count() > 3)
                                        {
                                            <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center border border-white border-2 shadow-sm"
                                                 style="width: 30px; height: 30px; margin-left: -10px; font-size: 9px; font-weight: bold;">
                                                +@(activity.ActivitiesSupImgs.Count() - 3)
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small" style="font-size: 11px;">No Gallery</span>
                                }
                            </div>
                        </td>
                        <td class="text-end pe-4">
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm btn-icon shadow-none" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                @if (User.IsInRole(DS.SUPER_ADMIN_ROLE) || User.IsInRole(DS.ADMIN_ROLE))
                                {
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow p-2" style="border-radius: 10px;">
                                        <li>
                                            <a class="dropdown-item rounded py-2" asp-action="Edit" asp-route-id="@activity.Id">
                                                <i class="bi bi-pencil-square me-2 text-primary small"></i>Edit Details
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider opacity-50"></li>
                                        <li>
                                            <a class="dropdown-item rounded py-2 text-danger" asp-action="Delete" asp-route-id="@activity.Id"
                                            onclick="return confirm('Remove this activity from catalog?');">
                                                <i class="bi bi-trash3 me-2 small"></i>Delete Activity
                                            </a>
                                        </li>
                                    </ul>
                                }else{
                                      <td>NO Action!</td>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-5">
                        <div class="d-flex flex-column align-items-center">
                            <i class="bi bi-stars text-muted display-4 mb-2 opacity-25"></i>
                            <h5 class="text-muted fw-normal">No additional activities yet</h5>
                            <a asp-action="Create" class="btn btn-sm btn-outline-primary mt-2">Start Adding</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


    <style>
        .bg-light-warning {
            background-color: #fff8dd !important;
        }

        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
        }

        .table tbody tr {
            transition: background-color 0.2s;
        }

            .table tbody tr:hover {
                background-color: #fafafa;
            }

        .avatar-group img {
            transition: transform 0.2s ease;
            cursor: pointer;
        }

            .avatar-group img:hover {
                transform: translateY(-3px) scale(1.1);
                z-index: 10;
            }

        .dropdown-item {
            font-size: 0.85rem;
            font-weight: 500;
        }

            .dropdown-item:hover {
                background-color: #f8f9fa;
            }
    </style>
