@using Ecommerce.Utilities
@model IEnumerable<Entertainment_travel_booking_website.Models.Hotel>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hotels Management";
}
@section Scripts {

    @if (TempData["sucess-Notification"] != null)
    {
        <script>
            toastr.success('@TempData["sucess-Notification"]');
        </script>
    }
    else if (TempData["error-Notification"] != null)
    {
        <script>
            toastr.error('@TempData["error-Notification"]');
        </script>
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Hotels Portfolio</h2>
        <p class="text-muted mb-0">Manage your properties, pricing, and visual gallery</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
        <i class="bi bi-plus-circle me-2"></i>Add New Hotel
    </a>
</div>

<div class="table-responsive">
    <table class="table align-middle table-hover bg-white" style="border-radius: 12px; overflow: hidden; border-collapse: separate; border-spacing: 0;">
        <thead class="bg-light">
            <tr>
                <th class="border-0 ps-4 py-3 text-uppercase fs-7 fw-bold text-muted">Hotel Details</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Location</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Price / Night</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Status</th>
                <th class="border-0 py-3 text-uppercase fs-7 fw-bold text-muted">Gallery</th>
                <th class="border-0 py-3 text-end pe-4 text-uppercase fs-7 fw-bold text-muted">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var hotel in Model)
                {
                    <tr style="border-bottom: 1px solid #f0f0f0;">
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(hotel.Image))
                                {
                                    <img src="~/images/hotels/@hotel.Image" alt="@hotel.Name"
                                         class="rounded shadow-sm me-3"
                                         style="width: 50px; height: 50px; object-fit: cover; border: 1px solid #eee;" />
                                }
                                else
                                {
                                    <div class="symbol symbol-50px me-3 bg-light-secondary d-flex align-items-center justify-content-center rounded" style="width: 50px; height: 50px; background-color: #f8f9fa;">
                                        <i class="bi bi-building fs-4 text-muted"></i>
                                    </div>
                                }
                                <div>
                                    <span class="text-dark fw-bold d-block fs-6">@hotel.Name</span>
                                    <small class="text-muted">ID: #@hotel.Id</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-geo-alt me-2 text-primary"></i>
                                <span class="text-dark fw-medium">@hotel.Location</span>
                            </div>
                        </td>
                        <td>
                            <span class="fw-bold text-dark">$@hotel.PricePerNight</span>
                        </td>
                        <td>
                            @if (hotel.Availability)
                            {
                                <span class="badge bg-light-success text-success px-3 py-2 border border-success rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light-danger text-danger px-3 py-2 border border-danger rounded-pill">
                                    <i class="bi bi-x-circle-fill me-1"></i> Full
                                </span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                @if (hotel.HotelSupImgs != null && hotel.HotelSupImgs.Any())
                                {
                                    <div class="avatar-group d-flex">
                                        @foreach (var sup in hotel.HotelSupImgs.Take(3))
                                        {
                                            <img src="~/images/hotel-sup/@sup.SupImg"
                                                 class="rounded-circle border border-white border-2 shadow-sm"
                                                 style="width: 28px; height: 28px; object-fit: cover; margin-left: -8px;" />
                                        }
                                        @if (hotel.HotelSupImgs.Count() > 3)
                                        {
                                            <div class="rounded-circle bg-dark text-white border border-white border-2 d-flex align-items-center justify-content-center shadow-sm"
                                                 style="width: 28px; height: 28px; margin-left: -8px; font-size: 9px; font-weight: bold;">
                                                +@(hotel.HotelSupImgs.Count() - 3)
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fs-7 small">No Gallery</span>
                                }
                            </div>
                        </td>
                        <td class="text-end pe-4">
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm btn-icon shadow-none" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                @if(User.IsInRole(DS.SUPER_ADMIN_ROLE) || User.IsInRole(DS.ADMIN_ROLE))
                                {
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm p-2">
                                        <li>
                                            <a class="dropdown-item rounded" asp-action="Edit" asp-route-id="@hotel.Id">
                                                <i class="bi bi-pencil-square me-2 text-primary"></i> Edit Hotel
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider text-light"></li>
                                        <li>
                                            <a class="dropdown-item rounded text-danger" asp-action="Delete" asp-route-id="@hotel.Id"
                                               onclick="return confirm('Delete this property? All associated rooms will be affected.');">
                                                <i class="bi bi-trash3 me-2"></i> Delete
                                            </a>
                                        </li>
                                    </ul>
                                }
                                else
                                {
                                    <td>NO Action!</td>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-5">
                        <div class="d-flex flex-column align-items-center">
                            <i class="bi bi-building-dash text-muted display-4 mb-3"></i>
                            <h5 class="text-muted">No properties found</h5>
                            <a asp-action="Create" class="btn btn-sm btn-outline-primary mt-2">Add First Hotel</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* @section Scripts { *@
    <style>
        .fs-7 {
            font-size: 0.85rem;
        }

        .bg-light-success {
            background-color: #e8fff3 !important;
        }

        .bg-light-danger {
            background-color: #fff5f8 !important;
        }

        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
        }

        .table tbody tr:last-child {
            border-bottom: none;
        }

        .table tbody tr:hover {
            background-color: #fcfcfc;
        }

        .dropdown-item {
            padding: 8px 12px;
            font-weight: 500;
            font-size: 0.9rem;
            transition: 0.2s;
        }

            .dropdown-item:hover {
                background-color: #f8f9fa;
            }

        /* Animation for avatar group */
        .avatar-group img {
            transition: transform 0.2s ease;
        }

            .avatar-group img:hover {
                transform: translateY(-3px);
                z-index: 10;
            }
    </style>
