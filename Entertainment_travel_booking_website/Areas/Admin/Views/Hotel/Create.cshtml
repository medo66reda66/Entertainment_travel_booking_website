@model Entertainment_travel_booking_website.modelVM.HotelCreateVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Hotel";
}

<div class="container-fluid">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-2">
            <i class="bi bi-arrow-left"></i> Back to Hotels List
        </a>
        <h2 class="fw-bold text-dark">Create New Hotel</h2>
        <p class="text-muted">Register a new property with its details, pricing, and gallery.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-primary">
                        <i class="bi bi-building me-2"></i>Hotel General Information
                    </h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">
                            <div class="col-md-12">
                                <label asp-for="Name" class="form-label fw-semibold text-dark">Hotel Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-pennant text-muted"></i></span>
                                    <input asp-for="Name" class="form-control bg-light border-start-0 shadow-none" placeholder="e.g. Grand Continental Hotel" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label fw-semibold text-dark">Full Address / Location</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                                    <input asp-for="Location" class="form-control bg-light border-start-0 shadow-none" placeholder="e.g. Downtown, Cairo, Egypt" />
                                </div>
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PricePerNight" class="form-label fw-semibold text-dark">Price Per Night ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-dollar text-muted"></i></span>
                                    <input asp-for="PricePerNight" class="form-control bg-light border-start-0 shadow-none" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold text-dark">Hotel Description</label>
                                <textarea asp-for="Description" class="form-control bg-light shadow-none" rows="5" placeholder="Enter a captivating description of the hotel and its unique services..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MainImage" class="form-label fw-semibold text-dark">Main Cover Photo</label>
                                <input asp-for="MainImage" class="form-control bg-light shadow-none" type="file" />
                                <span asp-validation-for="MainImage" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SupImages" class="form-label fw-semibold text-dark">Additional Gallery Photos</label>
                                <input asp-for="SupImages" class="form-control bg-light shadow-none" type="file" multiple />
                                <span asp-validation-for="SupImages" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch p-3 bg-light rounded-3 border-0 shadow-sm">
                                    <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="Status" id="hotelStatus" checked>
                                    <label class="form-check-label fw-bold text-dark" for="hotelStatus">
                                        Active & Listed for Public
                                    </label>
                                    <div class="form-text ms-5">Only active hotels will be visible to travelers on the website.</div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-3">
                            <button type="submit" class="btn btn-primary px-5 py-3 fw-bold shadow-sm rounded-3">
                                <i class="bi bi-cloud-check me-2"></i>Publish Hotel
                            </button>
                            <a asp-action="Index" class="btn btn-light px-5 py-3 fw-bold text-muted border rounded-3">
                                Discard
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

