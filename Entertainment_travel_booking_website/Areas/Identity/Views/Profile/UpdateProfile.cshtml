@model Entertainment_travel_booking_website.modelVM.ApplicationUserVM
@{
    ViewData["Title"] = "الملف الشخصي - TravelGo";
}

<div class="min-h-screen bg-[#f8fafc] py-12 px-4">
    <div class="max-w-4xl mx-auto">

        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-3xl font-black text-gray-900 tracking-tight">إعدادات <span class="text-blue-600">الحساب</span></h1>
                <p class="text-gray-500 font-medium mt-1">إدارة معلوماتك الشخصية وأمان حسابك</p>
            </div>
            <div class="hidden md:block">
                <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center border border-blue-100 shadow-sm">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                </div>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="flex items-center gap-3 bg-green-50 border border-green-100 text-green-700 p-4 rounded-2xl mb-8 animate-bounce">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <span class="font-bold text-sm">@TempData["SuccessMessage"]</span>
            </div>
        }

        <form asp-action="UpdateProfile" method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-8 text-right" dir="rtl">

            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-gray-100">
                    <h3 class="text-lg font-black text-gray-800 mb-6 flex items-center gap-2">
                        <span class="w-2 h-6 bg-blue-600 rounded-full"></span>
                        بيانات المسافر
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-black text-gray-400 mr-2 uppercase tracking-widest">الاسم الأول</label>
                            <input asp-for="FirstName" class="w-full bg-gray-50 border-none p-4 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-bold text-gray-700 transition-all" placeholder="محمد" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-black text-gray-400 mr-2 uppercase tracking-widest">اسم العائلة</label>
                            <input asp-for="LastName" class="w-full bg-gray-50 border-none p-4 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-bold text-gray-700 transition-all" placeholder="علي" />
                        </div>
                    </div>

                    <div class="mt-6 space-y-2">
                        <label class="text-xs font-black text-gray-400 mr-2 uppercase tracking-widest">البريد الإلكتروني</label>
                        <input asp-for="Email" type="email" class="w-full bg-gray-50 border-none p-4 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-bold text-gray-700 transition-all text-left" dir="ltr" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                        <div class="space-y-2">
                            <label class="text-xs font-black text-gray-400 mr-2 uppercase tracking-widest">رقم الهاتف</label>
                            <input asp-for="PhoneNumber" class="w-full bg-gray-50 border-none p-4 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-bold text-gray-700 transition-all text-left" dir="ltr" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-black text-gray-400 mr-2 uppercase tracking-widest">العنوان الحالي</label>
                            <input asp-for="Address" class="w-full bg-gray-50 border-none p-4 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-bold text-gray-700 transition-all" placeholder="القاهرة، مصر" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-1 space-y-6">
                <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-gray-100">
                    <h3 class="text-lg font-black text-gray-800 mb-6 flex items-center gap-2">
                        <span class="w-2 h-6 bg-orange-500 rounded-full"></span>
                        الأمان
                    </h3>

                    <div class="space-y-4">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-400 mr-2">كلمة المرور الحالية</label>
                            <input asp-for="CurrentPassword" type="password" class="w-full bg-gray-50 border-none p-4 rounded-2xl outline-none focus:ring-2 focus:ring-orange-500 font-bold transition-all" placeholder="••••••••" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-400 mr-2">كلمة المرور الجديدة</label>
                            <input asp-for="NewPassword" type="password" class="w-full bg-gray-50 border-none p-4 rounded-2xl outline-none focus:ring-2 focus:ring-orange-500 font-bold transition-all" placeholder="••••••••" />
                        </div>
                    </div>
                </div>

                <button type="submit" class="group w-full bg-blue-600 text-white p-6 rounded-[2rem] font-black text-lg shadow-xl shadow-blue-100 hover:bg-blue-700 hover:shadow-blue-200 transition-all active:scale-95 flex items-center justify-center gap-3">
                    <span>حفظ التغييرات</span>
                    <svg class="w-6 h-6 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14" /></svg>
                </button>

                <p class="text-center text-gray-400 text-xs font-bold px-4">
                    بمجرد الحفظ سيتم تحديث بياناتك فوراً في جميع خدمات TravelGo
                </p>
            </div>
        </form>
    </div>
</div>

<style>
    /* لمسات إضافية للـ Premium Look */
    input::placeholder {
        color: #cbd5e1;
        font-weight: 400;
    }

    /* أنيميشن خفيف عند ظهور الصفحة */
    form {
        animation: slideUp 0.6s ease-out;
    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>