@using Entertainment_travel_booking_website.modelVM
@model ForgotPasswordVM


@{
    ViewData["Title"] = "استعادة كلمة المرور";
    Layout = "_IdentityLayout";
}

<div class="bg-white/90 backdrop-blur-xl p-8 md:p-12 rounded-[2.5rem] shadow-2xl border border-white/50">
    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-50 text-blue-600 rounded-full mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>
        <h1 class="text-3xl font-black text-gray-900 mb-2">نسيت كلمة المرور؟</h1>
        <p class="text-gray-500 font-bold text-sm leading-relaxed px-4">لا تقلق، أدخل بريدك الإلكتروني وسنرسل لك رابطاً لتعيين كلمة مرور جديدة.</p>
    </div>

    <form asp-action="ForgotPassword" method="post" class="space-y-6 text-right">
        <div asp-validation-summary="ModelOnly" class="text-danger text-xs font-bold mb-4"></div>

        <div>
            <label asp-for="Email" class="block text-xs font-black text-blue-600 uppercase mb-2 mr-2">البريد الإلكتروني</label>
            <input asp-for="Email" class="w-full bg-gray-50 border-2 border-gray-100 p-4 rounded-2xl outline-none focus:border-blue-500 focus:bg-white transition-all font-bold text-gray-700 placeholder:text-gray-300" placeholder="example@mail.com" />
            <span asp-validation-for="Email" class="text-red-500 text-[10px] font-bold mt-1 block mr-2"></span>
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white py-5 rounded-[1.8rem] font-black text-lg shadow-xl shadow-blue-100 hover:bg-gray-900 transition-all active:scale-95 flex items-center justify-center gap-2">
            <span>إرسال رابط الاستعادة</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </button>
    </form>

    <div class="mt-8 pt-6 border-t border-gray-100 text-center">
        <a asp-action="Login" class="inline-flex items-center gap-2 text-sm font-black text-gray-400 hover:text-blue-600 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            العودة لتسجيل الدخول
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}