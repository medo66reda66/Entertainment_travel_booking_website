@using Entertainment_travel_booking_website.modelVM
@model NewPasswordVM

@{
    ViewData["Title"] = "تعيين كلمة مرور جديدة";
    Layout = "_IdentityLayout";
}

<div class="bg-white/90 backdrop-blur-xl p-8 md:p-12 rounded-[2.5rem] shadow-2xl border border-white/50">
    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-green-50 text-green-600 rounded-full mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04 Pel 12 21.48a11.955 11.955 0 01-8.618-3.04z" />
            </svg>
        </div>
        <h1 class="text-3xl font-black text-gray-900 mb-2">كلمة مرور جديدة</h1>
        <p class="text-gray-500 font-bold text-sm leading-relaxed px-4">أنت على بعد خطوة واحدة من تأمين حسابك. اختر كلمة مرور قوية.</p>
    </div>

    <form asp-action="NewPassword" class="space-y-6 text-right">
        <input type="hidden" name="Applicationuserid" value="@Model.Applicationuserid" />
        <div asp-validation-summary="ModelOnly" class="text-danger text-[10px] font-bold mb-4 mr-2"></div>

        <div>
            <label asp-for="Password" class="block text-xs font-black text-blue-600 uppercase mb-2 mr-2">كلمة المرور الجديدة</label>
            <input asp-for="Password" type="password" class="w-full bg-gray-50 border-2 border-gray-100 p-4 rounded-2xl outline-none focus:border-blue-500 focus:bg-white transition-all font-bold text-gray-700" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-red-500 text-[10px] font-bold mt-1 block mr-2"></span>
        </div>

        <div>
            <label asp-for="Confirmpassword" class="block text-xs font-black text-blue-600 uppercase mb-2 mr-2">تأكيد كلمة المرور</label>
            <input asp-for="Confirmpassword" type="password" class="w-full bg-gray-50 border-2 border-gray-100 p-4 rounded-2xl outline-none focus:border-blue-500 focus:bg-white transition-all font-bold text-gray-700" placeholder="••••••••" />
            <span asp-validation-for="Confirmpassword" class="text-red-500 text-[10px] font-bold mt-1 block mr-2"></span>
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white py-5 rounded-[1.8rem] font-black text-lg shadow-xl shadow-blue-100 hover:bg-gray-900 transition-all active:scale-95 flex items-center justify-center gap-2">
            <span>تحديث كلمة المرور</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
        </button>
    </form>

    <div class="mt-8 pt-6 border-t border-gray-100 text-center">
        <a href="/" class="text-xs font-black text-gray-400 hover:text-blue-600 transition underline underline-offset-4">تخطي والعودة للرئيسية</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}