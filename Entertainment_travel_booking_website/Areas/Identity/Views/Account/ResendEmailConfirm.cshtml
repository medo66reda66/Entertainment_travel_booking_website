@using Entertainment_travel_booking_website.modelVM
@model ResendEmailConfirmVM

@{
    ViewData["Title"] = "إعادة إرسال تأكيد البريد";
    Layout = "_IdentityLayout";
}

<div class="bg-white/90 backdrop-blur-xl p-8 md:p-12 rounded-[2.5rem] shadow-2xl border border-white/50">
    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-50 text-blue-600 rounded-full mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>
        <h1 class="text-3xl font-black text-gray-900 mb-2">تفعيل الحساب</h1>
        <p class="text-gray-500 font-bold text-sm leading-relaxed px-4">لم يصلك رمز التفعيل؟ لا مشكلة، أدخل بريدك الإلكتروني وسنقوم بإرسال رابط جديد فوراً.</p>
    </div>

    <form asp-action="ResendEmailConfirm" method="post" class="space-y-6 text-right">
        <div asp-validation-summary="ModelOnly" class="text-danger text-xs font-bold mb-4 mr-2"></div>

        <div>
            <label asp-for="Email" class="block text-xs font-black text-blue-600 uppercase mb-2 mr-2">البريد الإلكتروني</label>
            <input asp-for="Email" class="w-full bg-gray-50 border-2 border-gray-100 p-4 rounded-2xl outline-none focus:border-blue-500 focus:bg-white transition-all font-bold text-gray-700" placeholder="example@mail.com" />
            <span asp-validation-for="Email" class="text-red-500 text-[10px] font-bold mt-1 block mr-2"></span>
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white py-5 rounded-[1.8rem] font-black text-lg shadow-xl shadow-blue-100 hover:bg-gray-900 transition-all active:scale-95 flex items-center justify-center gap-2">
            <span>إرسال رابط التفعيل</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
        </button>
    </form>

    <div class="mt-8 pt-6 border-t border-gray-100 flex flex-col items-center gap-3">
        <a asp-action="Login" class="text-sm font-black text-blue-600 hover:text-orange-500 transition">العودة لتسجيل الدخول</a>
        <a href="/" class="text-[10px] font-bold text-gray-400 hover:text-gray-600 transition tracking-widest uppercase">الرئيسية</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}