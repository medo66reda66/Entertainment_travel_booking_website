@using Entertainment_travel_booking_website.Models
@model IEnumerable<Trip>

@{
    Layout = "_Layout";
    var popularDestinations = ViewBag.PopularDestinations as IEnumerable<dynamic>;
    var hotels = ViewBag.Hotels as IEnumerable<Hotel>;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}
@section Scripts {

    @if (TempData["sucess-Notification"] != null)
    {
        <script>
            toastr.success('@TempData["sucess-Notification"]');
        </script>
    }
    else if (TempData["error-Notification"] != null)
    {
        <script>
            toastr.error('@TempData["error-Notification"]');
        </script>
    }
}

<main class="w-[85%] max-w-[1400px] mx-auto px-4 py-20">

    <!-- ====== فلتر الوجهة والسعر والفندق والحالة ====== -->
    <section class="mb-8 p-6 bg-gray-50 rounded-xl flex flex-wrap gap-4 items-end justify-between shadow-sm">
        <form method="get" class="flex flex-wrap gap-4 items-end">

            <!-- الوجهة -->
            <div>
                <label class="block text-gray-600 text-sm font-bold">الوجهة</label>
                <input type="text" name="destination" class="border rounded px-3 py-1" value="@Context.Request.Query["destination"]" />
            </div>

            <!-- السعر الأدنى -->
            <div>
                <label class="block text-gray-600 text-sm font-bold">السعر الأدنى</label>
                <input type="number" name="minPrice" class="border rounded px-3 py-1" value="@Context.Request.Query["minPrice"]" />
            </div>

            <!-- السعر الأعلى -->
            <div>
                <label class="block text-gray-600 text-sm font-bold">السعر الأعلى</label>
                <input type="number" name="maxPrice" class="border rounded px-3 py-1" value="@Context.Request.Query["maxPrice"]" />
            </div>

            <!-- الفندق -->
            <div>
                <label class="block text-gray-600 text-sm font-bold">الفندق</label>
                <select name="hotelId" class="border rounded px-3 py-1">
                    <option value="">كل الفنادق</option>
                    @if (hotels != null)
                    {
                        foreach (var h in hotels)
                        {
                            <option value="@h.Id" @(Context.Request.Query["hotelId"] == h.Id.ToString() ? "selected" : "")>@h.Name</option>
                        }
                    }
                </select>
            </div>

            <!-- متاح فقط -->
            <div class="flex items-center gap-2 mt-1">
                <input type="checkbox" name="available" value="true" @(Context.Request.Query["available"] == "true" ? "checked" : "") class="w-5 h-5 rounded text-blue-600" />
                <label class="text-gray-600 font-bold">متاح فقط</label>
            </div>

            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-xl font-bold hover:bg-blue-700">تطبيق الفلتر</button>
        </form>
    </section>

    <!-- ====== عرض الرحلات ====== -->
    <section id="trips" class="mb-24">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            @if (Model != null && Model.Any())
            {
                @foreach (var trip in Model)
                {
                    <div class="bg-white rounded-[2rem] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-gray-50 group flex flex-col">
                        <div class="relative h-56 overflow-hidden">
                            <img src="~/images/trips/@trip.Image"
                                 class="w-full h-full object-cover group-hover:scale-110 transition duration-700"
                                 onerror="this.src='https://images.unsplash.com/photo-1506461883276-594a12b11cf3?auto=format&fit=crop&w=600'">

                            @if (trip.Status)
                            {
                                <div class="absolute top-4 right-4 bg-blue-600 text-white px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest">متاح</div>
                            }
                        </div>

                        <div class="p-6 text-right flex flex-col flex-grow">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-gray-400 text-[10px] font-bold italic">📍 @trip.Place</span>
                                <span class="text-gray-400 text-[10px] font-bold italic">🏨 @trip.Hotel?.Name</span>
                            </div>

                            <h3 class="text-lg font-black text-gray-900 mb-2 group-hover:text-blue-600 transition line-clamp-1">رحلة @trip.Place</h3>
                            <p class="text-gray-500 text-xs leading-relaxed mb-4 line-clamp-2">@trip.Description</p>

                            <div class="mt-auto border-t border-gray-50 pt-4 flex justify-between items-center">
                                <div>
                                    <p class="text-[9px] text-gray-400 font-black uppercase">السعر</p>
                                    <p class="text-lg font-black text-gray-900">@trip.Price.ToString("N0") <span class="text-[10px] font-bold">EGP</span></p>
                                </div>
                                <a href="/Customer/Home/Detail/@trip.Id"
                                   class="bg-blue-600 text-white px-4 py-2 rounded-xl cursor-pointer text-sm font-black hover:bg-gray-900 transition shadow-md active:scale-95 text-center">
                                    تفاصيل
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- ====== الباجينيشن ====== -->
        @if (totalPages > 1)
        {
            <div class="flex justify-center items-center gap-2 mt-16">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="@Url.Action("Index", new { page = i, destination = Context.Request.Query["destination"], minPrice = Context.Request.Query["minPrice"], maxPrice = Context.Request.Query["maxPrice"], hotelId = Context.Request.Query["hotelId"], available = Context.Request.Query["available"] })"
                       class="pagination-link w-10 h-10 flex items-center justify-center rounded-xl font-black transition-all shadow-sm
                               @(currentPage == i ? "bg-blue-600 text-white scale-110 shadow-blue-200" : "bg-white text-gray-400 hover:bg-gray-50 border border-gray-100")">
                        @i
                    </a>
                }
            </div>
        }
    </section>
</main>
