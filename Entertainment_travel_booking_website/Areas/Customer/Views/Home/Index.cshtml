@using Entertainment_travel_booking_website.Models
@{
    Layout = "_Layout";
    var popularDestinations = ViewBag.PopularDestinations as IEnumerable<dynamic>;
    var hotels = ViewBag.Hotels as IEnumerable<Hotel>;
}
@model IEnumerable<Trip>

<main class="w-[85%] max-w-[1400px] mx-auto px-4 py-20">

    @* --- قسم الوجهات الشائعة --- *@
    <section id="popular" class="mb-24">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-black text-gray-900 mb-4">وجهات شائعة</h2>
            <p class="text-gray-500 font-bold italic">الوجهات التي يعشقها المسافرون هذا الموسم</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            @if (popularDestinations != null)
            {
                @foreach (var dest in popularDestinations)
                {
                    <div class="relative h-80 rounded-[2.5rem] overflow-hidden group destination-card shadow-lg cursor-pointer">
                        <img src="~/images/trips/@dest.Image"
                             asp-append-version="true"
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                             onerror="this.src='https://images.unsplash.com/photo-1539367628448-4bc5c9d171c8?auto=format&fit=crop&w=400'">

                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex flex-col justify-end p-8">
                            <h4 class="text-white text-xl font-black">@dest.Name</h4>
                            <p class="text-blue-300 text-sm font-bold">@dest.Count رحلات متاحة</p>
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    @* --- الحاوية الأساسية للـ AJAX --- *@
    <div id="trips-container">
        <section id="trips" class="mb-24">
            <div class="flex justify-between items-end mb-12">
                <div>
                    <h2 class="text-3xl font-black text-gray-900 mb-2">أحدث الرحلات المضافة</h2>
                    <p class="text-gray-500 font-bold italic text-sm">كن أول من يحجز في عروضنا الجديدة</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                @if (Model != null && Model.Any())
                {
                    @foreach (var trip in Model)
                    {
                        <div class="bg-white rounded-[2rem] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-gray-50 group flex flex-col">
                            <div class="relative h-56 overflow-hidden">
                                <img src="~/images/trips/@trip.Image"
                                     asp-append-version="true"
                                     class="w-full h-full object-cover group-hover:scale-110 transition duration-700"
                                     onerror="this.src='https://images.unsplash.com/photo-1506461883276-594a12b11cf3?auto=format&fit=crop&w=600'">

                                @if (trip.Status)
                                {
                                    <div class="absolute top-4 right-4 bg-blue-600 text-white px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest">متاح</div>
                                }
                            </div>

                            <div class="p-6 text-right flex flex-col flex-grow">
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-orange-500 font-black text-xs">★ @(trip.Rate?.ToString("0.0") ?? "5.0")</span>
                                    <span class="text-gray-400 text-[10px] font-bold italic">📍 @trip.Place</span>
                                </div>

                                <h3 class="text-lg font-black text-gray-900 mb-2 group-hover:text-blue-600 transition line-clamp-1">رحلة @trip.Place</h3>
                                <p class="text-gray-500 text-xs leading-relaxed mb-4 line-clamp-2">@trip.Description</p>

                                <div class="mt-auto border-t border-gray-50 pt-4 flex justify-between items-center">
                                    <div>
                                        <p class="text-[9px] text-gray-400 font-black uppercase">السعر</p>
                                        <p class="text-lg font-black text-gray-900">@trip.Price.ToString("N0") <span class="text-[10px] font-bold">EGP</span></p>
                                    </div>

                                    <a asp-action="Details" asp-controller="Home" asp-route-id="@trip.Id"
                                       class="bg-blue-600 text-white px-4 py-2 rounded-xl cursor-pointer text-sm font-black hover:bg-gray-900 transition shadow-md active:scale-95 text-center">
                                        تفاصيل
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @* --- الباجينيشن (تأكد من وجود الكلاس pagination-link) --- *@
            @if (ViewBag.TotalPages > 1)
            {
                <div class="flex justify-center items-center gap-2 mt-16">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <a href="@Url.Action("Index", new { page = i, destination = Context.Request.Query["destination"] })"
                           class="pagination-link w-10 h-10 flex items-center justify-center rounded-xl font-black transition-all shadow-sm
                           @(ViewBag.CurrentPage == i ? "bg-blue-600 text-white scale-110 shadow-blue-200" : "bg-white text-gray-400 hover:bg-gray-50 border border-gray-100")">
                            @i
                        </a>
                    }
                </div>
            }
        </section>
    </div>
</main>

@* --- الجافا سكريبت القاضي على الريلود --- *@
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // نستخدم document on عشان يفضل شغال حتى بعد تبديل المحتوى
        $(document).on('click', '.pagination-link', function (e) {
            e.preventDefault(); // وقف الريلود فوراً

            var url = $(this).attr('href');
            var container = $('#trips-container');

            // تأثير بصري للتحميل
            container.css('opacity', '0.3');

            $.ajax({
                url: url,
                type: 'GET',
                success: function (result) {
                    // استخراج المحتوى الجديد فقط
                    var html = $(result).find('#trips-container').html();
                    container.html(html);

                    // تحديث العنوان في المتصفح من غير ريلود
                    window.history.pushState(null, '', url);

                    container.css('opacity', '1');

                    // سكرول ناعم لمكان الرحلات
                    $('html, body').animate({
                        scrollTop: container.offset().top - 80
                    }, 400);
                },
                error: function () {
                    container.css('opacity', '1');
                    console.log("حدث خطأ في جلب البيانات.");
                }
            });
        });
    });
</script>