@model List<CartItem>
@{
    Layout = "_Layout";
}

<main class="w-[90%] max-w-5xl mx-auto py-12">
    <h2 class="text-3xl font-black text-gray-800 mb-8 border-b-4 border-blue-600 inline-block pb-2">سلة التسوق</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-20 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200">
            <p class="text-xl text-gray-500 mb-6">العربة فارغة حالياً.. ابدأ باستكشاف الرحلات!</p>
            <a href="/" class="bg-blue-600 text-white px-8 py-3 rounded-full hover:bg-blue-700 transition">العودة للرئيسية</a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto bg-white rounded-2xl shadow-xl">
            <table class="w-full text-right border-collapse">
                <thead>
                    <tr class="bg-gray-800 text-white">
                        <th class="p-4">الرحلة</th>
                        <th class="p-4">الأنشطة الإضافية</th>
                        <th class="p-4">إجمالي السعر</th>
                        <th class="p-4 text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-blue-50/50 transition">
                            <td class="p-4 font-bold text-gray-700">@item.Trip?.Place</td>
                            <td class="p-4">
                                @if (item.SelectedActivities != null && item.SelectedActivities.Any())
                                {
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var act in item.SelectedActivities)
                                        {
                                            <span class="bg-blue-100 text-blue-700 text-xs px-2 py-1 rounded-md border border-blue-200">
                                                @act.Place ($@act.Price)
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-400 text-sm italic">لا توجد أنشطة</span>
                                }
                            </td>
                            <td class="p-4 font-black text-green-600">$@item.TotalPrice</td>
                            <td class="p-4 text-center">
                                <form asp-action="RemoveFromCart" method="post" class="inline">
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <button type="submit" class="text-red-500 hover:text-red-700 font-medium text-sm flex items-center justify-center gap-1 mx-auto">
                                        <span>إزالة</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-8 flex flex-col items-end gap-4">
            <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100 w-full md:w-80">
                <div class="flex justify-between items-center mb-6">
                    <span class="text-gray-600">المجموع الكلي:</span>
                    <span class="text-2xl font-black text-gray-900">$@Model.Sum(x => x.TotalPrice)</span>
                </div>

                <form asp-action="Payment" method="post">
                    <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-xl font-bold hover:bg-green-700 shadow-lg shadow-green-100 transition-all active:scale-95">
                        إتمام عملية الدفع
                    </button>
                </form>
            </div>

            <a href="/" class="text-blue-600 hover:underline">متابعة التسوق</a>
        </div>
    }
</main>