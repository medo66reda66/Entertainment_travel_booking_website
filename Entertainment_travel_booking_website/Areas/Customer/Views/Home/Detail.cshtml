@model Entertainment_travel_booking_website.Models.ViewModels.TripDetailVM
@{
    ViewData["Title"] = Model.Trip.Place;
    Layout = "_Layout";
}

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">

<main class="w-[90%] max-w-7xl mx-auto px-4 py-12 lg:py-20 font-['Cairo'] antialiased">

    <header class="text-center mb-16 animate-fade-in">
        <nav class="flex justify-center gap-2 mb-4">
            <span class="bg-blue-100 text-blue-600 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider">رحلة سياحية</span>
            @if (Model.Trip.Status)
            {
                <span class="bg-green-100 text-green-600 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider">متاحة الآن</span>
            }
        </nav>
        <h1 class="text-5xl md:text-6xl font-black text-gray-900 mb-6 tracking-tight">
            @Model.Trip.Place
        </h1>
        <div class="flex items-center justify-center gap-4 text-gray-500">
            <span class="flex items-center gap-1 font-bold"> <i class="fas fa-hotel text-blue-500"></i> @Model.Hotel?.Name</span>
            <span class="text-gray-300">|</span>
            <span class="font-medium">أفضل تجربة ترفيهية في @Model.Trip.Place</span>
        </div>
    </header>

    <div class="grid lg:grid-cols-3 gap-12">

        <!-- القسم الأيسر: صور الرحلة والفندق -->
        <div class="lg:col-span-2 space-y-12">

            <!-- معرض صور الرحلة -->
            <section class="gallery-container">
                <h2 class="text-2xl font-black text-gray-800 mb-6 flex items-center gap-3">
                    <span class="w-2 h-8 bg-blue-600 rounded-full"></span>
                    معرض صور الرحلة
                </h2>
                <div class="relative group">
                    <img id="mainTripImage"
                         src="@Url.Content(Model.Trip.Image != null ? "~/images/trips/" + Model.Trip.Image : "~/images/placeholder/trip-placeholder.jpg")"
                         class="w-full h-[400px] md:h-[550px] object-cover rounded-[2.5rem] shadow-2xl transition-all duration-500" />
                </div>

                @if (Model.Trip.TripSupimages != null && Model.Trip.TripSupimages.Any())
                {
                    <div class="thumbs-wrapper mt-6">
                        <img src="@Url.Content("~/images/trips/" + Model.Trip.Image)" class="thumb active trip-thumb" data-full="@Url.Content("~/images/trips/" + Model.Trip.Image)" />
                        @foreach (var img in Model.Trip.TripSupimages)
                        {
                            <img src="@Url.Content("~/images/trip-sup/" + img.SupImg)"
                                 class="thumb trip-thumb"
                                 data-full="@Url.Content("~/images/trip-sup/" + img.SupImg)" />
                        }
                    </div>
                }
            </section>

            <!-- قسم الفندق -->
            @if (Model.Hotel != null)
            {
                <section class="bg-gray-50 rounded-[3rem] p-8 border border-gray-100">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                        <div>
                            <h2 class="text-3xl font-black text-gray-900">إقامتك في @Model.Hotel.Name</h2>
                            <p class="text-gray-500 font-bold mt-1">استمتع بأرقى الخدمات الفندقية</p>
                        </div>
                        <a href="@Url.Action("HotelDetail", "Home", new { area = "Customer", id = Model.Hotel.Id })"
                           class="px-8 py-4 bg-white text-blue-600 font-black rounded-2xl hover:bg-blue-600 hover:text-white transition-all shadow-sm border border-blue-100 active:scale-95">
                            تفاصيل الفندق الكاملة
                        </a>
                    </div>

                    <div class="relative">
                        <img id="mainHotelImage"
                             src="@Url.Content(Model.Hotel.Image != null ? "~/images/hotels/" + Model.Hotel.Image : "~/images/placeholder/hotel-placeholder.jpg")"
                             class="w-full h-[350px] object-cover rounded-[2rem] shadow-lg" />

                        @if (Model.Hotel.HotelSupImgs != null && Model.Hotel.HotelSupImgs.Any())
                        {
                            <div class="thumbs-wrapper mt-4">
                                @foreach (var img in Model.Hotel.HotelSupImgs)
                                {
                                    <img src="@Url.Content("~/images/hotel-sup/" + img.SupImg)"
                                         class="thumb hotel-thumb"
                                         data-full="@Url.Content("~/images/hotel-sup/" + img.SupImg)" />
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- القسم الأيمن: تخصيص الرحلة -->
        <div class="lg:col-span-1">
            <div class="sticky top-8 space-y-6">

                <section class="bg-white rounded-[2.5rem] shadow-2xl shadow-blue-100/50 p-8 border border-blue-50">
                    <h3 class="text-xl font-black text-gray-900 mb-6">تخصيص رحلتك</h3>
                    <form asp-area="Customer" asp-controller="Home" asp-action="AddToCart" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TripId" value="@Model.Trip.Id" />

                        <!-- أنشطة إضافية -->
                        <div class="space-y-3 mb-6">
                            @foreach (var act in Model.AdditionalActivities)
                            {
                                <label class="activity-card">
                                    <input type="checkbox" name="SelectedActivityIds" value="@act.Id" class="activity-checkbox" data-price="@act.Price" />
                                    <span>@act.Place</span>
                                    <span>$@act.Price</span>
                                </label>
                            }
                        </div>

                        <!-- عدد الأفراد -->
                        <div class="mb-6 p-4 bg-gray-50 rounded-2xl border border-gray-100 text-center">
                            <label class="block text-sm font-black text-gray-700 mb-4">عدد الأفراد (المسافرين)</label>
                            <div class="flex items-center justify-center gap-6">
                                <button type="button" onclick="changeCount(-1)" class="w-12 h-12 flex items-center justify-center bg-white border-2 border-blue-600 text-blue-600 rounded-xl hover:bg-blue-600 hover:text-white transition-all font-black text-2xl">-</button>

                                <input type="number" name="Quantity" id="tripQuantity" value="1" min="1" class="w-16 text-center text-2xl font-black bg-transparent border-none focus:ring-0" readonly />

                                <button type="button" onclick="changeCount(1)" class="w-12 h-12 flex items-center justify-center bg-white border-2 border-blue-600 text-blue-600 rounded-xl hover:bg-blue-600 hover:text-white transition-all font-black text-2xl">+</button>
                            </div>
                        </div>

                        <!-- السعر النهائي -->
                        <div class="mb-6 p-4 bg-gray-50 rounded-2xl border border-gray-100 text-center">
                            <p class="text-gray-700 font-bold mb-2">السعر النهائي:</p>
                            <h3 class="text-3xl font-black text-blue-600">$<span id="totalPrice">@Model.Trip.Price</span></h3>
                        </div>

                        <button type="submit" class="w-full bg-blue-600 text-white py-5 rounded-2xl font-black">
                            حجز الرحلة والذهاب للسلة
                        </button>
                    </form>
                </section>

                <!-- مميزات الدفع -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-green-50 p-4 rounded-2xl border border-green-100 text-center">
                        <i class="fas fa-shield-alt text-green-600 mb-2"></i>
                        <p class="text-[10px] font-black text-green-700">دفع آمن 100%</p>
                    </div>
                    <div class="bg-orange-50 p-4 rounded-2xl border border-orange-100 text-center">
                        <i class="fas fa-clock text-orange-600 mb-2"></i>
                        <p class="text-[10px] font-black text-orange-700">تأكيد فوري</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        // معرض الصور
        const setupGallery = (thumbsClass, mainId) => {
            const mainImg = document.getElementById(mainId);
            const thumbs = document.querySelectorAll(thumbsClass);

            thumbs.forEach(thumb => {
                thumb.addEventListener('click', function () {
                    thumbs.forEach(t => t.classList.remove('border-blue-600', 'scale-105'));
                    this.classList.add('border-blue-600', 'scale-105');
                    mainImg.style.opacity = '0.5';
                    setTimeout(() => {
                        mainImg.src = this.dataset.full;
                        mainImg.style.opacity = '1';
                    }, 150);
                });
            });
        };

        setupGallery('.trip-thumb', 'mainTripImage');
        setupGallery('.hotel-thumb', 'mainHotelImage');

        // تحديث السعر
        function updateTotal() {
            const basePrice = parseFloat("@Model.Trip.Price");
            const quantity = parseInt(document.getElementById('tripQuantity').value);
            const checkboxes = document.querySelectorAll('.activity-checkbox');
            const totalEl = document.getElementById('totalPrice');

            let extra = 0;
            checkboxes.forEach(x => {
                if (x.checked) extra += parseFloat(x.dataset.price || 0);
            });

            const finalTotal = (basePrice + extra) * quantity;

            if (totalEl) {
                totalEl.textContent = finalTotal.toLocaleString();
                totalEl.classList.add('scale-110', 'text-blue-500');
                setTimeout(() => totalEl.classList.remove('scale-110', 'text-blue-500'), 200);
            }
        }

        // مستمع لتغيير الأنشطة
        document.querySelectorAll('.activity-checkbox').forEach(cb => {
            cb.addEventListener('change', updateTotal);
        });

        // مستمع للعداد
        window.changeCount = function (amount) {
            const input = document.getElementById('tripQuantity');
            let currentValue = parseInt(input.value);
            let newValue = currentValue + amount;
            if (newValue >= 1) {
                input.value = newValue;
                updateTotal();
            }
        }
    });
</script>

<style>
    body {
        background-color: #fcfcfd;
    }

    .thumbs-wrapper {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding: 10px 2px;
        scrollbar-width: none;
    }

        .thumbs-wrapper::-webkit-scrollbar {
            display: none;
        }

    .thumb {
        width: 100px;
        height: 70px;
        flex-shrink: 0;
        object-fit: cover;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 3px solid transparent;
    }

        .thumb:hover {
            transform: translateY(-3px);
        }

    .activity-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border: 2px solid #f8fafc;
        border-radius: 20px;
        background: #f8fafc;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .activity-card:has(input:checked) {
            border-color: #3b82f6;
            background: #eff6ff;
            transform: translateX(-5px);
        }

    .activity-checkbox {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        accent-color: #2563eb;
    }

    #totalPrice {
        transition: all 0.3s ease;
        display: inline-block;
    }
 

    .animate-fade-in {
        animation: fade-in 0.8s ease-out forwards;
    }
</style>
