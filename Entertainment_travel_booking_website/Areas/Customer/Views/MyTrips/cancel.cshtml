@{
    Layout = "_Layout";
    ViewData["Title"] = "Payment Cancelled | TravelGo";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&family=Poppins:wght@400;600;800&display=swap');

    .travelgo-font {
        font-family: 'Poppins', 'Cairo', sans-serif;
    }
</style>

<div class="min-h-screen flex items-center justify-center bg-[#fff5f5] travelgo-font px-4 py-10">
    <div class="relative bg-white p-8 md:p-14 rounded-[3rem] shadow-[0_20px_50px_rgba(220,38,38,0.05)] text-center max-w-xl w-full border border-white overflow-hidden">

        <div class="absolute -top-24 -right-24 w-48 h-48 bg-red-50 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-orange-50 rounded-full blur-3xl"></div>

        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-red-400 via-orange-500 to-rose-600"></div>

        <div class="flex justify-center mb-10">
            <div class="relative">
                <div class="absolute inset-0 rounded-full bg-red-100 opacity-50 scale-125"></div>
                <div class="relative w-28 h-28 rounded-full bg-gradient-to-br from-red-500 to-rose-600 shadow-[0_10px_30px_rgba(220,38,38,0.3)] flex items-center justify-center transform hover:rotate-12 transition duration-500 cursor-default">
                    <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="mb-8">
            <h1 class="text-4xl md:text-5xl font-[900] text-slate-900 mb-2 leading-tight">
                لـم تكتمل الرحلة! <span class="inline-block animate-pulse"></span>
            </h1>
            <div class="inline-block px-4 py-1 bg-red-50 rounded-full">
                <span class="text-sm font-bold text-red-700 uppercase tracking-widest italic">Payment Cancelled</span>
            </div>
        </div>

        <div class="space-y-4 mb-12">
            <p class="text-xl font-bold text-slate-800 leading-tight">
                يبدو أن هناك عائقاً في الطريق..
            </p>
            <p class="text-slate-500 text-base md:text-lg font-medium max-w-sm mx-auto leading-relaxed">
                لا تقلق، لم يتم خصم أي مبالغ من حسابك. يمكنك مراجعة بيانات الدفع والمحاولة مرة أخرى لحجز رحلتك.
            </p>
        </div>

            <a href="/Customer/Home/Index"
               class="w-full py-4 bg-white text-slate-400 font-bold rounded-2xl border-2 border-slate-100 shadow-sm hover:border-red-200 hover:text-red-600 hover:bg-red-50 transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span>العودة للرئيسية</span>
            </a>
        </div>

        <div class="mt-10 pt-8 border-t border-slate-50">
            <p class="text-slate-400 font-medium">
                تحتاج مساعدة؟ <a href="#" class="text-red-500 hover:text-red-700 transition">فريق الدعم في انتظارك</a>
            </p>
        </div>
    </div>
</div>