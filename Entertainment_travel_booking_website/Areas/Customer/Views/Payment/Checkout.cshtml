@model Entertainment_travel_booking_website.Models.Order
@{
    Layout = "_Layout";
}

<main class="w-[90%] max-w-3xl mx-auto py-16">

    <h2 class="text-3xl font-bold mb-6 text-center">Complete Payment</h2>

    <!-- Trip Info -->
    <div class="mb-6 p-6 bg-gray-100 rounded-2xl shadow-md">
        <h3 class="text-xl font-bold mb-2">@Model.OrderItems?.FirstOrDefault()?.TripName</h3>
        <p class="text-green-600 font-semibold text-lg">
            Total Price: $<span id="totalPrice">@Model.TotalPrice</span>
        </p>
    </div>

    <!-- Payment Form -->
    <form asp-action="Checkout" method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        <!-- Hidden Fields -->
        <input type="hidden" name="tripId" value="@Model.OrderItems?.FirstOrDefault()?.TripId" />
        <input type="hidden" name="Quantity" value="@Model.OrderItems?.FirstOrDefault()?.Quantity" />
        <input type="hidden" name="TotalPrice" id="TotalPriceHidden" value="@Model.TotalPrice" />

        <!-- الأنشطة الإضافية -->
        @if (ViewBag.AvailableActivities != null)
        {
            foreach (var act in (List<Entertainment_travel_booking_website.Models.AdditianActivities>)ViewBag.AvailableActivities)
            {
                // تحقق إذا كان النشاط مختاراً مسبقاً من TripDetail.cshtml
                var isChecked = ViewBag.SelectedActivityIds != null && ((List<int>)ViewBag.SelectedActivityIds).Contains(act.Id);
                @* <div>
                    <input type="checkbox" name="SelectedActivityIds" value="@act.Id" data-price="@act.Price" class="activity-checkbox" @(isChecked ? "checked" : "") />
                    <label>@act.Place - $@act.Price</label>
                </div> *@
            }
        }

        <!-- Card Name -->
        <div>
            <label asp-for="CardName" class="block font-semibold mb-1">Name on Card</label>
            <input asp-for="CardName" class="w-full p-4 border rounded-xl focus:ring-2 focus:ring-green-500" placeholder="John Doe" />
            <span asp-validation-for="CardName" class="text-red-500 text-sm"></span>
        </div>

        <!-- Card Number -->
        <div>
            <label asp-for="CardNumber" class="block font-semibold mb-1">Card Number</label>
            <input asp-for="CardNumber" class="w-full p-4 border rounded-xl focus:ring-2 focus:ring-green-500" placeholder="1234 5678 9012 3456" />
            <span asp-validation-for="CardNumber" class="text-red-500 text-sm"></span>
        </div>

        <!-- Expiry Date -->
        <div>
            <label asp-for="ExpiryDate" class="block font-semibold mb-1">Expiry Date</label>
            <input asp-for="ExpiryDate" class="w-full p-4 border rounded-xl focus:ring-2 focus:ring-green-500" placeholder="MM/YY" />
            <span asp-validation-for="ExpiryDate" class="text-red-500 text-sm"></span>
        </div>

        <!-- CVV -->
        <div>
            <label asp-for="CVV" class="block font-semibold mb-1">CVV</label>
            <input asp-for="CVV" class="w-full p-4 border rounded-xl focus:ring-2 focus:ring-green-500" placeholder="123" />
            <span asp-validation-for="CVV" class="text-red-500 text-sm"></span>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="w-full bg-green-600 text-white py-4 rounded-2xl font-bold hover:bg-green-700 transition duration-300">
            Confirm Payment
        </button>
    </form>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // السعر الأساسي للرحلة فقط (من ViewBag، بدون أنشطة)
        const basePrice = @ViewBag.TripPrice;
        const quantity = @Model.OrderItems.FirstOrDefault()?.Quantity ?? 1;
        const totalPriceElem = document.getElementById("totalPrice");
        const totalPriceHidden = document.getElementById("TotalPriceHidden");

        // دالة تحديث السعر النهائي
        function updateTotal() {
            let activitiesTotal = 0;
            // جمع سعر الأنشطة المختارة
            document.querySelectorAll(".activity-checkbox:checked").forEach(c => {
                activitiesTotal += parseFloat(c.dataset.price);
            });
            // السعر النهائي = (سعر الرحلة + سعر الأنشطة) × الكمية
            const finalPrice = (basePrice + activitiesTotal) * quantity;
            totalPriceElem.innerText = finalPrice.toFixed(2);
            totalPriceHidden.value = finalPrice.toFixed(2); // يُرسل إلى السيرفر للتحقق (اختياري، لكن السيرفر يحسب من البيانات)
        }

        // تحديث عند تغيير الـ checkboxes
        document.querySelectorAll(".activity-checkbox").forEach(cb => {
            cb.addEventListener("change", updateTotal);
        });

        // تحديث عند تحميل الصفحة (للسعر الأولي إذا كانت الأنشطة مختارة)
        document.addEventListener("DOMContentLoaded", updateTotal);
    </script>


}