@{
    Layout = "_Layout";
    ViewData["Title"] = "Payment Success";
}

<main class="w-[90%] max-w-3xl mx-auto py-16 text-center">
    <form action="/customer/mytrips/index" method="post">
    <h2 class="text-3xl font-bold text-green-600 mb-6">Payment Successful!</h2>

    <p class="text-gray-700 mb-6">
        شكراً على الحجز، تم استلام الدفع بنجاح.
    </p>

        <button type="submit"
                class="bg-green-600 text-white px-8 py-4 rounded-2xl font-bold hover:bg-green-700 transition">
     
        الذهاب إلى رحلاتي
        </button>
</main>
