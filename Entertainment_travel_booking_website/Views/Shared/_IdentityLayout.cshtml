<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelGo</title>

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            min-height: 100vh;
        }
        /* تنسيق إضافي لتحسين شكل فورم الهوية الافتراضي */
        .card {
            border-radius: 2rem !important;
            border: none !important;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        }

        .btn-primary {
            background-color: #2563eb !important;
            border: none !important;
            border-radius: 1rem !important;
            padding: 0.75rem !important;
            font-weight: 900 !important;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen">

    <nav class="bg-white/80 backdrop-blur-md shadow-sm p-4 sticky top-0 z-[100]">
        <div class="container mx-auto flex justify-between items-center">
            <a href="/" class="text-3xl font-black text-blue-600 tracking-tighter italic">Travel<span class="text-orange-500 italic">GO✈️</span></a>
            <a href="/" class="text-gray-500 font-bold text-sm hover:text-blue-600 transition flex items-center gap-2">
                <span>العودة للرئيسية</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            </a>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-12 flex-grow flex items-center justify-center">
        <div class="w-full max-w-lg">
            @RenderBody()
        </div>
    </div>

    <footer class="py-6 text-center text-gray-400 text-xs font-bold">
        © 2026 TravelGo. جميع الحقوق محفوظة.
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>