@using Entertainment_travel_booking_website.Utilities

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TravelGo - وجهتك المثالية</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #fcfcfc;
            scroll-behavior: smooth;
            
        }
        

        .price-slider {
            -webkit-appearance: none;
            width: 100%;
            height: 6px;
            background: #e2e8f0;
            border-radius: 10px;
            outline: none;
        }

            .price-slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                width: 20px;
                height: 20px;
                background: #2563eb;
                border: 3px solid white;
                border-radius: 50%;
                cursor: pointer;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        .glass-effect {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
        }

        .destination-card:hover img {
            transform: scale(1.1);
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>

</head>
<body class="flex flex-col min-h-screen">


    <nav class="bg-white/80 backdrop-blur-md shadow-sm p-4 sticky top-0 z-[100] border-b border-gray-100">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-10">
                <div class="text-3xl font-black text-blue-600 tracking-tighter italic">TravelGo</div>
                <ul class="hidden md:flex gap-8 text-sm font-bold text-gray-600">
                    @* وجهات شائعة *@
                    <li>
                        <a href="/Customer/Home/Index#popular"
                           class="hover:text-blue-600 transition relative after:content-[''] after:absolute after:bottom-[-4px] after:right-0 after:w-0 after:h-[2px] after:bg-blue-600 hover:after:w-full after:transition-all">
                            وجهات شائعة
                        </a>
                    </li>

                    @* الرحلات *@
                    <li>
                        <a href="/Customer/Home/Index#trips"
                           class="hover:text-blue-600 transition relative after:content-[''] after:absolute after:bottom-[-4px] after:right-0 after:w-0 after:h-[2px] after:bg-blue-600 hover:after:w-full after:transition-all">
                            الرحلات
                        </a>
                    </li>

                    @* لماذا نحن؟ *@
                    <li>
                        <a href="/Customer/Home/Index#why-us"
                           class="hover:text-blue-600 transition relative after:content-[''] after:absolute after:bottom-[-4px] after:right-0 after:w-0 after:h-[2px] after:bg-blue-600 hover:after:w-full after:transition-all">
                            لماذا نحن؟
                        </a>
                    </li>
                    <li>
                        <a href="/Customer/MyTrips/Index"
                           class="bg-white text-blue-600 px-4 py-2 rounded-full font-semibold shadow-md hover:bg-blue-500 hover:text-white transition">
                            رحلاتي
                        </a>
                    </li>
                </ul>
            </div>

            <div class="flex items-center gap-4">
                @if (!User.Identity.IsAuthenticated)
                {
                    <a href="/Identity/Account/Register" class="hidden md:block text-gray-500 font-bold text-sm px-4 hover:text-blue-600 transition">إنشاء حساب</a>
                    <a href="/Identity/Account/Login" class="bg-blue-600 text-white px-8 py-2.5 rounded-xl font-black hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-200 transition-all active:scale-95 text-sm">
                        تسجيل دخول
                    </a>
                }
                else
                {
                    <div class="relative group">
                        <button class="flex items-center gap-3 p-1.5 pl-4 bg-gray-50/50 hover:bg-white border border-gray-100 rounded-2xl transition-all duration-300 group-hover:shadow-md">
                            @* الأفاتار *@
                            <div class="w-10 h-10 bg-gradient-to-tr from-blue-600 to-blue-400 text-white rounded-[0.9rem] flex items-center justify-center font-black shadow-sm">
                                @User.Identity.Name.Substring(0, 1).ToUpper()
                            </div>

                            <div class="hidden lg:flex flex-col items-end leading-tight">
                                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">مرحباً بك</span>
                                <span class="text-sm font-black text-gray-800">@User.Identity.Name</span>
                            </div>

                            <svg class="w-4 h-4 text-gray-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </button>

                        <div class="absolute left-0 mt-3 w-64 bg-white rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.15)] border border-gray-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[110] transform origin-top-left group-hover:scale-100 scale-95 overflow-hidden">

                            <div class="p-4 space-y-1">
                                @* رابط الداشبورد للأدمن *@
                                @if (User.IsInRole("SUPER_ADMIN_ROLE") || User.IsInRole("ADMIN_ROLE"))
                                {
                                    <a href="/Admin/Trip/Index" class="flex items-center gap-3 p-3.5 text-indigo-600 hover:bg-indigo-50 rounded-2xl transition-all font-black text-sm">
                                        <div class="p-2 bg-indigo-100 rounded-lg">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14" /></svg>
                                        </div>
                                        لوحة التحكم
                                    </a>
                                    <div class="h-px bg-gray-50 mx-2 my-1"></div>
                                }

                                @* رابط ملفي الشخصي *@
                                <a href="/Identity/Profile/UpdateProfile" class="flex items-center gap-3 p-3.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-2xl transition-all font-bold text-sm">
                                    <div class="p-2 bg-gray-100 rounded-lg group-hover:bg-blue-100">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                    </div>
                                    ملفي الشخصي
                                </a>  <a href="/Admin/Trip/Index" class="flex items-center gap-3 p-3.5 text-gray-700 hover:bg-blue-50 hover:text-blue-600 rounded-2xl transition-all font-bold text-sm">
                                    <div class="p-2 bg-gray-100 rounded-lg group-hover:bg-blue-100">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                    </div>
                                    Dashboard
                                </a>
                            </div>

                            @* زر الخروج *@
                            <div class="p-4 bg-gray-50/80 border-t border-gray-50">
                                <a href="/Identity/Account/Logout" class="flex items-center justify-center gap-2 w-full p-3.5 bg-white text-red-500 hover:bg-red-500 hover:text-white rounded-[1.2rem] font-black text-sm transition-all shadow-sm border border-red-100/50">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" /></svg>
                                    خروج
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </nav>


    @if (ViewData["ShowHero"] != null && (bool)ViewData["ShowHero"])
    {
        <section class="relative h-[650px] flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black/20 z-10"></div>
            <img src="https://images.unsplash.com/photo-1503177119275-0aa32b3a9368?auto=format&fit=crop&w=1600" class="absolute inset-0 w-full h-full object-cover scale-105" alt="Background">

            <div class="relative z-20 text-center px-4 w-full max-w-6xl">
                <h1 class="text-5xl md:text-7xl font-black text-white mb-8 drop-shadow-2xl leading-tight">سافر، اكتشف، واستمتع <br><span class="text-orange-400">بكل لحظة</span></h1>

                <form id="filterForm" method="get">
                    <div class="glass-effect p-2 rounded-[2.5rem] shadow-2xl max-w-6xl mx-auto">
                        <div class="grid grid-cols-1 md:grid-cols-5 gap-2 items-center">

                            <div class="p-4 text-right border-l border-gray-100">
                                <p class="text-[10px] font-black text-blue-600 uppercase mb-1">الوجهة</p>
                                <input name="destination" value="@Context.Request.Query["destination"]" type="text" placeholder="أين تذهب؟" class="w-full bg-transparent font-bold outline-none text-gray-700">
                            </div>

                            <div class="p-4 text-right border-l border-gray-100">
                                <p class="text-[10px] font-black text-blue-600 uppercase mb-1">من تاريخ</p>
                                <input name="startDate" value="@Context.Request.Query["startDate"]" type="date" class="w-full bg-transparent font-bold outline-none text-gray-700 text-xs">
                            </div>

                            <div class="p-4 text-right border-l border-gray-100">
                                <p class="text-[10px] font-black text-blue-600 uppercase mb-1">إلى تاريخ</p>
                                <input name="endDate" value="@Context.Request.Query["endDate"]" type="date" class="w-full bg-transparent font-bold outline-none text-gray-700 text-xs">
                            </div>

                            <div class="p-4 text-right border-l border-gray-100">
                                <p class="flex justify-between text-[10px] font-black text-blue-600 uppercase mb-1">
                                    <span>السعر الأقصى</span>
                                    <span id="priceVal" class="text-gray-900">@(string.IsNullOrEmpty(Context.Request.Query["maxPrice"]) ? "5,000" : Context.Request.Query["maxPrice"]) EGP</span>
                                </p>
                                <input name="maxPrice" type="range" min="500" max="15000" step="500"
                                       value="@(Context.Request.Query["maxPrice"].ToString() ?? "5000")"
                                       class="price-slider"
                                       oninput="document.getElementById('priceVal').innerText = Number(this.value).toLocaleString() + ' EGP'">
                            </div>

                            <div class="p-2">
                                <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white w-full h-14 rounded-[1.8rem] font-black text-lg shadow-xl transition-all flex items-center justify-center gap-2">
                                    <span>استكشف</span>
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </section>
    }


    <main class="flex-grow  mx-auto px-4 py-20">
        @RenderBody()
    </main>

    <footer class="bg-gray-900 text-white pt-20 pb-10 mt-auto">
        <div class="container mx-auto px-6 text-right">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
                <div class="space-y-6">
                    <div class="text-3xl font-black text-blue-500 italic">TravelGo</div>
                    <p class="text-gray-400 leading-relaxed font-medium">نسعى لتغيير مفهوم السفر في المنطقة العربية من خلال توفير تجارب فريدة.</p>
                </div>
                <div>
                    <h4 class="text-lg font-black mb-6 border-r-4 border-blue-600 pr-3">روابط سريعة</h4>
                    <ul class="space-y-4 text-gray-400 font-bold text-sm">
                        <li><a href="#" class="hover:text-white transition">الرئيسية</a></li>
                        <li><a href="#trips" class="hover:text-white transition">استكشف الرحلات</a></li>
                        <li><a href="#why-us" class="hover:text-white transition">لماذا نحن؟</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-black mb-6 border-r-4 border-blue-600 pr-3">اشترك في العروض</h4>
                    <form class="space-y-3">
                        <input type="email" placeholder="بريدك الإلكتروني" class="w-full bg-gray-800 border-none p-4 rounded-2xl outline-none focus:ring-2 focus:ring-blue-600 text-white font-bold">
                        <button class="w-full bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-2xl font-black transition-all">اشترك الآن</button>
                    </form>
                </div>
            </div>
            <div class="pt-8 border-t border-gray-800 text-center text-gray-500 text-sm font-bold">
                © 2026 TravelGo. جميع الحقوق محفوظة.
            </div>
        </div>
        <div id="regModal" class="hidden fixed inset-0 bg-black/70 z-[200] flex items-center justify-center p-4 backdrop-blur-sm">
            <div class="bg-white rounded-[3rem] w-full max-w-md p-10 relative shadow-2xl">
                <button onclick="toggleModal('regModal')" class="absolute top-8 left-8 text-gray-300 hover:text-red-500 transition text-2xl">✕</button>
                <h2 class="text-3xl font-black mb-8 text-center text-gray-900">انضم لمسافرينا</h2>
                <form class="space-y-4 text-right">
                    <input type="text" placeholder="الاسم بالكامل" class="w-full bg-gray-50 border-none p-5 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-bold">
                    <input type="email" placeholder="البريد الإلكتروني" class="w-full bg-gray-50 border-none p-5 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-bold">
                    <button type="button" class="w-full bg-blue-600 text-white py-5 rounded-[1.8rem] font-black text-lg shadow-xl shadow-blue-100 hover:bg-blue-700 transition-all active:scale-95">إنشاء حسابي مجاناً</button>
                </form>
            </div>
        </div>
    </footer>

   

    <script>
        function toggleModal(id) {
            document.getElementById(id).classList.toggle('hidden');
        }
    </script>

</body>

</html>

<script>
    window.addEventListener('load', function() {
        // Scroll لو فيه بارامترات فلترة
        const urlParams = new URLSearchParams(window.location.search);

        if (urlParams.has('destination') || urlParams.has('maxPrice') || urlParams.has('startDate')) {
            const tripsSection = document.getElementById('trips');
            if (tripsSection) {
                tripsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        const filterForm = document.getElementById('filterForm');
        if (filterForm) {
            filterForm.addEventListener('submit', function (e) {
                e.preventDefault(); // منع الريلود
                const formData = new FormData(this);
                const params = new URLSearchParams(formData).toString();
                filterTrips(params);
            });
        }

        function filterTrips(params) {
            const container = document.getElementById('trips-container');
            if (!container) return;

            container.style.opacity = '0.5';

            fetch(`?${params}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(response => response.ok ? response.text() : Promise.reject('Network response was not ok'))
                .then(html => {
                    container.innerHTML = html;
                    container.style.opacity = '1';

                    const target = document.getElementById('trips');
                    if (target) target.scrollIntoView({ behavior: 'smooth' });

                    const newUrl = window.location.pathname + '?' + params;
                    history.pushState(null, '', newUrl);
                })
                .catch(error => {
                    console.error('Error:', error);
                    container.style.opacity = '1';
                });
        }
    });
</script>


 @RenderSection("Scripts", required: false) 

